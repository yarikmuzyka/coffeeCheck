    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "^0.35.5",
    "source-map-js": "1.2.2"
  }
